{
  "name": "mayray-backend",
  "version": "1.0.0",
  "description": "Mayray AI backend API — Express + Prisma + Supabase",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "ts-node src/utils/seeder.ts",
    "storage:setup": "ts-node scripts/setup-storage.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "@supabase/supabase-js": "^2.44.2",
    "@types/compression": "^1.8.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.13",
    "sanitize-html": "^2.17.7",
    "slugify": "^1.6.6",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "2.1.0",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/sanitize-html": "^2.16.1",
    "nodemon": "^3.1.3",
    "prisma": "^5.16.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
