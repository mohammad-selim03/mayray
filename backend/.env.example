PORT=5000
NODE_ENV=development

# Supabase — get these from your Supabase project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Prisma — Supabase connection pooling URL (Settings > Database > Connection Pooling)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (for migrations)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@mayray.com
ADMIN_PASSWORD=Admin@123456

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@mayray.com
FROM_NAME=Mayray AI

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Shared with the frontend; lets the API refresh cached pages after a publish
REVALIDATE_SECRET=change-me
# Supabase Storage bucket for CMS uploads (create it with: npm run storage:setup)
SUPABASE_BUCKET=mayray-assets
